<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>IPMax</RootNamespace>
    <AssemblyName>IPMax</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>IPMax</PackageId>
    <Version>0.1.0</Version>
    <Authors>IP-Max</Authors>
    <Company>IP-Max</Company>
    <Copyright>Copyright (c) IP-Max</Copyright>
    <Description>.NET client for the IP-Max GeoIP and IP intelligence API.</Description>
    <PackageTags>ip;geoip;geolocation;ip-intelligence;threat-intelligence;asn;rpki</PackageTags>
    <PackageProjectUrl>https://ipm.ax</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/IPMaxxing/dotnet-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
